{
  "regions": [
    "fra1"
  ],
  "headers": [
    {
      "source": "/onboarding(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/impressum.html",
      "destination": "/rechtliches.html#impressum",
      "permanent": false
    },
    {
      "source": "/datenschutz.html",
      "destination": "/rechtliches.html#datenschutz",
      "permanent": false
    },
    {
      "source": "/agb.html",
      "destination": "/rechtliches.html#mitgliedschaft",
      "permanent": false
    },
    {
      "source": "/disclaimer.html",
      "destination": "/rechtliches.html#hinweis",
      "permanent": false
    }
  ]
}
